<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:ad="https://github.com/NTLDR2/AvalonDock"
	xmlns:adconv="clr-namespace:AvalonDock.Converters;assembly=AvalonDock"
	xmlns:boilerplate="clr-namespace:ThemeSuperTestApp.Boilerplate"
	xmlns:cal="http://caliburnmicro.com"
	xmlns:docking="clr-namespace:ThemeSuperTestApp.Docking">

	<BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
	<adconv:NullToDoNothingConverter x:Key="NullToDoNothingConverter" />

	<!--
		Implicit DataTemplate for every DockableScreen (documents and toolboxes alike).
		DockingManager.LayoutItemTemplate MUST remain unset so views resolve cleanly in docked panes,
		LayoutFloatingWindowControl, and standalone DetachedAnchorableWindow ("Window" mode).
	-->
	<DataTemplate DataType="{x:Type boilerplate:DockableScreen}">
		<ContentControl cal:View.Model="{Binding}" IsTabStop="False" />
	</DataTemplate>

	<!--
		Optional icon-enabled DocumentHeaderTemplate (DataContext = LayoutDocument, Content = ViewModel).
		Renders IconSource + Title + unsaved indicator across all themes.
		ShellView can toggle DockingManager.DocumentHeaderTemplate between this template and null
		to compare custom vs. theme-native tab header rendering.
	-->
	<DataTemplate x:Key="IconDocumentHeaderTemplate">
		<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
			<Image
				Width="14"
				Height="14"
				Margin="0,0,5,0"
				VerticalAlignment="Center"
				Source="{Binding Content.IconSource, FallbackValue={x:Null}}">
				<Image.Style>
					<Style TargetType="{x:Type Image}">
						<Style.Triggers>
							<DataTrigger Binding="{Binding Content.IconSource}" Value="{x:Null}">
								<Setter Property="Visibility" Value="Collapsed" />
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</Image.Style>
			</Image>
			<TextBlock
				MaxWidth="220"
				VerticalAlignment="Center"
				Text="{Binding Title}"
				TextTrimming="CharacterEllipsis" />
			<TextBlock
				Margin="4,0,0,0"
				VerticalAlignment="Center"
				FontWeight="Bold"
				Text="&#x25CF;"
				ToolTip="Modified specimen state"
				Visibility="{Binding Content.IsModified, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}" />
		</StackPanel>
	</DataTemplate>

	<Style x:Key="DocumentItemStyle" TargetType="{x:Type ad:LayoutItem}">
		<Setter Property="Title" Value="{Binding Model.Title}" />
		<Setter Property="ContentId" Value="{Binding Model.Id}" />
		<Setter Property="ToolTip" Value="{Binding Model.ToolTipText}" />
		<Setter Property="CanClose" Value="{Binding Model.CanClose}" />
		<Setter Property="CanFloat" Value="{Binding Model.CanFloat}" />
		<Setter Property="IconSource" Value="{Binding Model.IconSource, Converter={StaticResource NullToDoNothingConverter}}" />
	</Style>

	<Style x:Key="ToolboxItemStyle" TargetType="{x:Type ad:LayoutAnchorableItem}">
		<Setter Property="Title" Value="{Binding Model.Title}" />
		<Setter Property="ContentId" Value="{Binding Model.Id}" />
		<Setter Property="ToolTip" Value="{Binding Model.ToolTipText}" />
		<Setter Property="CanClose" Value="{Binding Model.CanClose}" />
		<Setter Property="CanFloat" Value="{Binding Model.CanFloat}" />
		<Setter Property="CanHide" Value="True" />
		<Setter Property="IconSource" Value="{Binding Model.IconSource, Converter={StaticResource NullToDoNothingConverter}}" />
	</Style>

	<docking:PanesStyleSelector
		x:Key="PanesStyleSelector"
		DocumentStyle="{StaticResource DocumentItemStyle}"
		ToolboxStyle="{StaticResource ToolboxItemStyle}" />

</ResourceDictionary>
