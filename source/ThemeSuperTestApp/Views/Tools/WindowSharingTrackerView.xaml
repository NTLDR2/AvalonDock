<UserControl
	x:Class="ThemeSuperTestApp.Views.Tools.WindowSharingTrackerView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:cal="http://caliburnmicro.com"
	Background="#FFFFFF"
	Foreground="#111827">

	<DockPanel Margin="6">
		<!-- Verdict Banner -->
		<Border
			Margin="0,0,0,5"
			Padding="7,4"
			BorderThickness="1"
			CornerRadius="3"
			DockPanel.Dock="Top">
			<Border.Style>
				<Style TargetType="{x:Type Border}">
					<Setter Property="Background" Value="#ECFDF5" />
					<Setter Property="BorderBrush" Value="#6EE7B7" />
					<Style.Triggers>
						<DataTrigger Binding="{Binding HasDuplicatedDictionaries}" Value="True">
							<Setter Property="Background" Value="#FFFBEB" />
							<Setter Property="BorderBrush" Value="#FCD34D" />
						</DataTrigger>
					</Style.Triggers>
				</Style>
			</Border.Style>
			<TextBlock
				FontSize="11.5"
				FontWeight="SemiBold"
				Foreground="#1F2937"
				Text="{Binding CurrentReport.VerdictText, FallbackValue='Ready'}"
				TextWrapping="Wrap" />
		</Border>

		<!-- Toolbar -->
		<WrapPanel
			Margin="0,0,0,5"
			DockPanel.Dock="Top"
			Orientation="Horizontal">
			<Button
				Margin="0,0,6,2"
				Padding="7,2"
				cal:Message.Attach="RefreshSnapshot"
				Content="Refresh Now"
				FontSize="11"
				FontWeight="SemiBold" />
			<CheckBox
				Margin="0,0,8,2"
				VerticalAlignment="Center"
				Content="Auto-Poll Windows (900ms)"
				FontSize="11"
				IsChecked="{Binding AutoPollEnabled, Mode=TwoWay}" />
			<Button
				Margin="0,0,6,2"
				Padding="7,2"
				cal:Message.Attach="CopySharingMarkdown"
				Content="Copy Markdown"
				FontSize="11" />
			<TextBlock
				VerticalAlignment="Center"
				FontFamily="Consolas"
				FontSize="11"
				Foreground="#374151"
				Text="{Binding TrackerStatusText}" />
		</WrapPanel>

		<TabControl Background="#FFFFFF">
			<TabItem Header="Live Open Hosts">
				<DataGrid
					AlternatingRowBackground="#F9FAFB"
					AutoGenerateColumns="False"
					Background="#FFFFFF"
					BorderBrush="#D1D5DB"
					CanUserAddRows="False"
					CanUserDeleteRows="False"
					Foreground="#111827"
					GridLinesVisibility="Horizontal"
					HeadersVisibility="Column"
					HorizontalGridLinesBrush="#E5E7EB"
					IsReadOnly="True"
					ItemsSource="{Binding Hosts}"
					RowBackground="#FFFFFF">
					<DataGrid.Columns>
						<DataGridTextColumn
							Width="200"
							Binding="{Binding HostKind}"
							FontFamily="Consolas"
							Header="Host Kind" />
						<DataGridTextColumn
							Width="165"
							Binding="{Binding ThemeDictionaryInstanceId}"
							FontFamily="Consolas"
							FontWeight="SemiBold"
							Header="Dictionary Object ID" />
						<DataGridTextColumn
							Width="95"
							Binding="{Binding SharesRootInstanceWithDockingManager}"
							Header="Shared Ref?" />
						<DataGridTextColumn
							Width="80"
							Binding="{Binding NestedMergedCount}"
							FontFamily="Consolas"
							Header="Merged" />
						<DataGridTextColumn
							Width="140"
							Binding="{Binding WindowTitle}"
							Header="Window / Host Title" />
						<DataGridTextColumn
							Width="250"
							Binding="{Binding SourceUri}"
							FontFamily="Consolas"
							Header="Source" />
					</DataGrid.Columns>
				</DataGrid>
			</TabItem>

			<TabItem Header="Observed Transient Windows (Overlay / Navigator)">
				<DockPanel Margin="4">
					<Button
						Margin="0,0,0,4"
						Padding="7,2"
						HorizontalAlignment="Left"
						cal:Message.Attach="ClearTransientHistory"
						Content="Clear Transient Log"
						DockPanel.Dock="Top"
						FontSize="11" />
					<DataGrid
						AlternatingRowBackground="#F9FAFB"
						AutoGenerateColumns="False"
						Background="#FFFFFF"
						BorderBrush="#D1D5DB"
						CanUserAddRows="False"
						CanUserDeleteRows="False"
						Foreground="#111827"
						GridLinesVisibility="Horizontal"
						HeadersVisibility="Column"
						HorizontalGridLinesBrush="#E5E7EB"
						IsReadOnly="True"
						ItemsSource="{Binding ObservedTransientHosts}"
						RowBackground="#FFFFFF">
						<DataGrid.Columns>
							<DataGridTextColumn
								Width="210"
								Binding="{Binding HostKind}"
								FontFamily="Consolas"
								Header="Transient Host" />
							<DataGridTextColumn
								Width="170"
								Binding="{Binding ThemeDictionaryInstanceId}"
								FontFamily="Consolas"
								Header="Dictionary Object ID" />
							<DataGridTextColumn
								Width="95"
								Binding="{Binding SharesRootInstanceWithDockingManager}"
								Header="Shared Ref?" />
							<DataGridTextColumn
								Width="250"
								Binding="{Binding SourceUri}"
								FontFamily="Consolas"
								Header="Source" />
						</DataGrid.Columns>
					</DataGrid>
				</DockPanel>
			</TabItem>
		</TabControl>
	</DockPanel>
</UserControl>
