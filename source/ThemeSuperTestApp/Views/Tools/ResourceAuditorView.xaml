<UserControl
	x:Class="ThemeSuperTestApp.Views.Tools.ResourceAuditorView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:cal="http://caliburnmicro.com"
	xmlns:models="clr-namespace:ThemeSuperTestApp.Models"
	Background="#FFFFFF"
	Foreground="#111827">

	<UserControl.Resources>
		<BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
	</UserControl.Resources>

	<DockPanel Margin="6">
		<!-- KPI Strip -->
		<WrapPanel
			Margin="0,0,0,5"
			DockPanel.Dock="Top"
			Orientation="Horizontal">
			<Border
				Margin="0,0,5,4"
				Padding="6,2"
				Background="#EFF6FF"
				BorderBrush="#93C5FD"
				BorderThickness="1"
				CornerRadius="3">
				<TextBlock FontSize="11" Foreground="#1E3A8A">
					<Run FontWeight="SemiBold" Text="Total Keys: " />
					<Run FontFamily="Consolas" Text="{Binding CurrentAuditReport.TotalEntries, Mode=OneWay, FallbackValue=0}" />
				</TextBlock>
			</Border>

			<Border
				Margin="0,0,5,4"
				Padding="6,2"
				Background="#F0FDF4"
				BorderBrush="#86EFAC"
				BorderThickness="1"
				CornerRadius="3">
				<TextBlock FontSize="11" Foreground="#166534">
					<Run FontWeight="SemiBold" Text="Frozen Freezables: " />
					<Run FontFamily="Consolas" Text="{Binding CurrentAuditReport.FrozenFreezableCount, Mode=OneWay, FallbackValue=0}" />
				</TextBlock>
			</Border>

			<!-- Unfrozen Warning Badge -->
			<Border
				Margin="0,0,5,4"
				Padding="6,2"
				BorderThickness="1"
				CornerRadius="3">
				<Border.Style>
					<Style TargetType="{x:Type Border}">
						<Setter Property="Background" Value="#F0FDF4" />
						<Setter Property="BorderBrush" Value="#86EFAC" />
						<Style.Triggers>
							<DataTrigger Binding="{Binding HasUnfrozenWarnings}" Value="True">
								<Setter Property="Background" Value="#FEF2F2" />
								<Setter Property="BorderBrush" Value="#FCA5A5" />
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</Border.Style>
				<TextBlock FontSize="11" FontWeight="SemiBold">
					<TextBlock.Style>
						<Style TargetType="{x:Type TextBlock}">
							<Setter Property="Foreground" Value="#166534" />
							<Style.Triggers>
								<DataTrigger Binding="{Binding HasUnfrozenWarnings}" Value="True">
									<Setter Property="Foreground" Value="#B91C1C" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</TextBlock.Style>
					<Run Text="Unfrozen (!): " />
					<Run FontFamily="Consolas" Text="{Binding CurrentAuditReport.UnfrozenFreezableCount, Mode=OneWay, FallbackValue=0}" />
				</TextBlock>
			</Border>

			<Button
				Margin="0,0,5,4"
				Padding="6,1"
				cal:Message.Attach="RefreshAudit"
				Content="Re-Audit"
				FontSize="11" />
			<Button
				Margin="0,0,0,4"
				Padding="6,1"
				cal:Message.Attach="CopyAuditSummaryMarkdown"
				Content="Copy Markdown"
				FontSize="11" />
		</WrapPanel>

		<TextBlock
			Margin="0,0,0,5"
			DockPanel.Dock="Top"
			FontSize="11"
			Foreground="#374151"
			Text="{Binding AuditorStatusText}"
			TextTrimming="CharacterEllipsis" />

		<TabControl Background="#FFFFFF">
			<!-- ==================== TAB 1: RESOURCE & FREEZABLE EXPLORER ==================== -->
			<TabItem Header="Live Dictionary &amp; Freezable Explorer">
				<DockPanel Margin="4">
					<DockPanel Margin="0,0,0,5" DockPanel.Dock="Top">
						<ComboBox
							Width="185"
							Margin="0,0,6,0"
							DockPanel.Dock="Left"
							ItemsSource="{Binding FilterModes}"
							SelectedItem="{Binding SelectedFilterMode, Mode=TwoWay}" />
						<TextBox
							VerticalContentAlignment="Center"
							Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
							ToolTip="Filter by key, value type, #AARRGGBB hex, or dictionary source" />
					</DockPanel>

					<DataGrid
						AlternatingRowBackground="#F9FAFB"
						AutoGenerateColumns="False"
						Background="#FFFFFF"
						BorderBrush="#D1D5DB"
						CanUserAddRows="False"
						CanUserDeleteRows="False"
						EnableRowVirtualization="True"
						Foreground="#111827"
						GridLinesVisibility="Horizontal"
						HeadersVisibility="Column"
						HorizontalGridLinesBrush="#E5E7EB"
						IsReadOnly="True"
						ItemsSource="{Binding FilteredEntries}"
						RowBackground="#FFFFFF">
						<DataGrid.Columns>
							<DataGridTemplateColumn Width="38" Header="Swatch">
								<DataGridTemplateColumn.CellTemplate>
									<DataTemplate DataType="{x:Type models:ResourceEntryRecord}">
										<Border
											Width="20"
											Height="14"
											HorizontalAlignment="Center"
											VerticalAlignment="Center"
											Background="{Binding SwatchBrush}"
											BorderBrush="#6B7280"
											BorderThickness="1"
											CornerRadius="2"
											Visibility="{Binding HasSwatch, Converter={StaticResource BooleanToVisibilityConverter}}" />
									</DataTemplate>
								</DataGridTemplateColumn.CellTemplate>
							</DataGridTemplateColumn>
							<DataGridTextColumn
								Width="115"
								Binding="{Binding ColorHex, TargetNullValue=-}"
								FontFamily="Consolas"
								Header="Color / Hex" />
							<DataGridTemplateColumn Width="95" Header="IsFrozen" SortMemberPath="FreezeStatus">
								<DataGridTemplateColumn.CellTemplate>
									<DataTemplate DataType="{x:Type models:ResourceEntryRecord}">
										<TextBlock
											HorizontalAlignment="Center"
											VerticalAlignment="Center"
											FontSize="11"
											FontWeight="SemiBold"
											Text="{Binding FreezeStatusText}">
											<TextBlock.Style>
												<Style TargetType="{x:Type TextBlock}">
													<Setter Property="Foreground" Value="#6B7280" />
													<Style.Triggers>
														<DataTrigger Binding="{Binding FreezeStatus}" Value="{x:Static models:ResourceFreezeStatus.Frozen}">
															<Setter Property="Foreground" Value="#15803D" />
														</DataTrigger>
														<DataTrigger Binding="{Binding FreezeStatus}" Value="{x:Static models:ResourceFreezeStatus.UnfrozenWarning}">
															<Setter Property="Foreground" Value="#DC2626" />
														</DataTrigger>
														<DataTrigger Binding="{Binding FreezeStatus}" Value="{x:Static models:ResourceFreezeStatus.RealizationError}">
															<Setter Property="Foreground" Value="#B91C1C" />
														</DataTrigger>
													</Style.Triggers>
												</Style>
											</TextBlock.Style>
										</TextBlock>
									</DataTemplate>
								</DataGridTemplateColumn.CellTemplate>
							</DataGridTemplateColumn>
							<DataGridTextColumn
								Width="290"
								Binding="{Binding KeyDisplay}"
								FontFamily="Consolas"
								Header="Key" />
							<DataGridTextColumn
								Width="135"
								Binding="{Binding ValueTypeName}"
								FontFamily="Consolas"
								Header="Value Type" />
							<DataGridTextColumn
								Width="280"
								Binding="{Binding SourceLocation}"
								FontFamily="Consolas"
								Header="Dictionary Source" />
						</DataGrid.Columns>
					</DataGrid>
				</DockPanel>
			</TabItem>

			<!-- ==================== TAB 2: CROSS-THEME SEMANTIC KEY DIFF ==================== -->
			<TabItem Header="Cross-Theme Key Diff">
				<DockPanel Margin="4">
					<WrapPanel
						Margin="0,0,0,5"
						DockPanel.Dock="Top"
						Orientation="Horizontal">
						<TextBlock
							Margin="0,0,5,0"
							VerticalAlignment="Center"
							FontSize="11.5"
							FontWeight="SemiBold"
							Text="Compare Active vs:" />
						<ComboBox
							MinWidth="175"
							Margin="0,0,8,0"
							DisplayMemberPath="DisplayName"
							ItemsSource="{Binding ComparisonThemes}"
							SelectedItem="{Binding ComparisonTheme, Mode=TwoWay}" />
						<TextBlock
							VerticalAlignment="Center"
							FontFamily="Consolas"
							FontSize="11"
							Foreground="#374151">
							<Run Text="Shared: " />
							<Run FontWeight="SemiBold" Text="{Binding CurrentDiffReport.SharedMatchingCount, Mode=OneWay, FallbackValue=0}" />
							<Run Text=" | Missing: " />
							<Run FontWeight="SemiBold" Foreground="#B91C1C" Text="{Binding CurrentDiffReport.MissingInActiveCount, Mode=OneWay, FallbackValue=0}" />
							<Run Text=" | Extra: " />
							<Run FontWeight="SemiBold" Foreground="#1D4ED8" Text="{Binding CurrentDiffReport.ExtraInActiveCount, Mode=OneWay, FallbackValue=0}" />
							<Run Text=" | Type Diff: " />
							<Run FontWeight="SemiBold" Foreground="#B45309" Text="{Binding CurrentDiffReport.TypeMismatchCount, Mode=OneWay, FallbackValue=0}" />
						</TextBlock>
					</WrapPanel>

					<TextBox
						Margin="0,0,0,5"
						DockPanel.Dock="Top"
						Text="{Binding DiffSearchText, UpdateSourceTrigger=PropertyChanged}"
						ToolTip="Filter diff rows by semantic key or type" />

					<DataGrid
						AlternatingRowBackground="#F9FAFB"
						AutoGenerateColumns="False"
						Background="#FFFFFF"
						BorderBrush="#D1D5DB"
						CanUserAddRows="False"
						CanUserDeleteRows="False"
						EnableRowVirtualization="True"
						Foreground="#111827"
						GridLinesVisibility="Horizontal"
						HeadersVisibility="Column"
						HorizontalGridLinesBrush="#E5E7EB"
						IsReadOnly="True"
						ItemsSource="{Binding FilteredDiffEntries}"
						RowBackground="#FFFFFF">
						<DataGrid.Columns>
							<DataGridTextColumn
								Width="125"
								Binding="{Binding DiffKindText}"
								Header="Diff Kind" />
							<DataGridTextColumn
								Width="270"
								Binding="{Binding SemanticKeySignature}"
								FontFamily="Consolas"
								Header="Normalized Semantic Key" />
							<DataGridTextColumn
								Width="140"
								Binding="{Binding ActiveValueType}"
								FontFamily="Consolas"
								Header="Active Type" />
							<DataGridTextColumn
								Width="140"
								Binding="{Binding ComparisonValueType}"
								FontFamily="Consolas"
								Header="Compared Type" />
						</DataGrid.Columns>
					</DataGrid>
				</DockPanel>
			</TabItem>
		</TabControl>
	</DockPanel>
</UserControl>
