<UserControl
	x:Class="ThemeSuperTestApp.Views.Tools.StressSpecimenToolboxView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<Border
		Margin="6"
		Padding="10"
		Background="#FFFBEB"
		BorderBrush="#FCD34D"
		BorderThickness="1"
		CornerRadius="4"
		TextElement.Foreground="#78350F">
		<StackPanel>
			<TextBlock
				Margin="0,0,0,6"
				FontSize="12.5"
				FontWeight="Bold"
				Text="Tear-Off / Detached Window Specimen" />
			<TextBlock
				Margin="0,0,0,6"
				FontSize="11"
				Text="This toolbox is used by 'Float Specimen' and 'Detach to OS Window' so your 5 diagnostic tools remain docked in the main window while you inspect:"
				TextWrapping="Wrap" />
			<TextBlock Margin="0,0,0,3" FontSize="11" Text="• Tool 3: Shared DictionaryTheme Ref #1 vs. Duplicated URI Theme Ref #2." TextWrapping="Wrap" />
			<TextBlock Margin="0,0,0,3" FontSize="11" Text="• DWM Title Bars: Native Windows dark/light title bar on DetachedAnchorableWindow." TextWrapping="Wrap" />
			<TextBlock FontSize="11" Text="• Auto-Hide Pin: Click the pin icon in this tool's header to inspect themed auto-hide tabs and flyout chrome." TextWrapping="Wrap" />
		</StackPanel>
	</Border>
</UserControl>
