<UserControl
	x:Class="ThemeSuperTestApp.Views.Tools.ThemeProfilerView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:cal="http://caliburnmicro.com"
	xmlns:models="clr-namespace:ThemeSuperTestApp.Models"
	Background="#FFFFFF"
	Foreground="#111827">

	<DockPanel Margin="6">
		<!-- Top KPI Summary Strip -->
		<WrapPanel
			Margin="0,0,0,6"
			DockPanel.Dock="Top"
			Orientation="Horizontal">
			<Border
				Margin="0,0,6,4"
				Padding="7,3"
				Background="#F0FDFA"
				BorderBrush="#5EEAD4"
				BorderThickness="1"
				CornerRadius="3">
				<TextBlock FontSize="11.5" Foreground="#0F766E">
					<Run FontWeight="SemiBold" Text="Theme (URI) Cold .ctor: " />
					<Run FontFamily="Consolas" Text="{Binding UriThemeAvgColdMsText, Mode=OneWay}" />
				</TextBlock>
			</Border>

			<Border
				Margin="0,0,6,4"
				Padding="7,3"
				Background="#F5F3FF"
				BorderBrush="#C4B5FD"
				BorderThickness="1"
				CornerRadius="3">
				<TextBlock FontSize="11.5" Foreground="#5B21B6">
					<Run FontWeight="SemiBold" Text="DictionaryTheme / VsTheme Cold .ctor: " />
					<Run FontFamily="Consolas" Text="{Binding DictionaryThemeAvgColdMsText, Mode=OneWay}" />
				</TextBlock>
			</Border>

			<Border
				Margin="0,0,6,4"
				Padding="7,3"
				Background="#FFF7ED"
				BorderBrush="#FDBA74"
				BorderThickness="1"
				CornerRadius="3">
				<TextBlock
					FontSize="11.5"
					FontWeight="SemiBold"
					Foreground="#9A3412"
					Text="{Binding XmlnsMissingSummaryText}" />
			</Border>

			<Border
				Margin="0,0,0,4"
				Padding="7,3"
				Background="#FEF3C7"
				BorderBrush="#FCD34D"
				BorderThickness="1"
				CornerRadius="3">
				<TextBlock
					FontSize="11.5"
					Foreground="#92400E"
					Text="{Binding NullResourceUriSummaryText}" />
			</Border>
		</WrapPanel>

		<!-- Action Toolbar -->
		<DockPanel Margin="0,0,0,6" DockPanel.Dock="Top">
			<StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
				<Button
					Margin="0,0,6,0"
					Padding="8,3"
					cal:Message.Attach="BenchmarkColdConstructors"
					Content="Benchmark All 20 Cold Constructors"
					FontWeight="SemiBold"
					ToolTip="Constructs a fresh instance of every registered theme and measures cold .ctor latency and managed byte allocation" />
				<Button
					Margin="0,0,6,0"
					Padding="8,3"
					cal:Message.Attach="SweepAllThemes"
					Content="Sweep &amp; Time Apply Across All 20 Themes"
					ToolTip="Applies every theme sequentially on DockingManager and measures OnThemeChanged + WPF Render pass latency" />
				<Button
					Margin="0,0,6,0"
					Padding="8,3"
					cal:Message.Attach="ApplySelectedRowTheme"
					Content="Apply Selected"
					ToolTip="Applies the highlighted row's theme to DockingManager (or double-click any row)" />
				<Button
					Padding="8,3"
					cal:Message.Attach="CopyBenchmarkMarkdown"
					Content="Copy Markdown Report"
					ToolTip="Copies the full 20-theme architecture and benchmark Markdown table to the clipboard" />
			</StackPanel>

			<TextBlock
				Margin="10,0,0,0"
				VerticalAlignment="Center"
				FontSize="11.5"
				Foreground="#374151"
				Text="{Binding ProfilerStatusText}"
				TextTrimming="CharacterEllipsis" />
		</DockPanel>

		<!-- 20-Theme Architecture & Timing Matrix -->
		<DataGrid
			cal:Message.Attach="[Event MouseDoubleClick] = [Action ApplyRowOnDoubleClick]"
			AlternatingRowBackground="#F9FAFB"
			AutoGenerateColumns="False"
			Background="#FFFFFF"
			BorderBrush="#D1D5DB"
			CanUserAddRows="False"
			CanUserDeleteRows="False"
			EnableRowVirtualization="True"
			Foreground="#111827"
			GridLinesVisibility="Horizontal"
			HeadersVisibility="Column"
			HorizontalGridLinesBrush="#E5E7EB"
			IsReadOnly="True"
			ItemsSource="{Binding Themes}"
			RowBackground="#FFFFFF"
			SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
			SelectionMode="Single">
			<DataGrid.Columns>
				<DataGridTextColumn
					Width="135"
					Binding="{Binding DisplayName}"
					Header="Theme" />
				<DataGridTextColumn
					Width="165"
					Binding="{Binding BaseClassBadgeText}"
					Header="Base Class" />
				<DataGridTextColumn
					Width="185"
					Binding="{Binding ClrNamespace}"
					FontFamily="Consolas"
					Header="CLR Namespace" />
				<DataGridTemplateColumn Width="105" Header="Xmlns Mapped" SortMemberPath="IsMappedInXmlnsDefinition">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate DataType="{x:Type models:ThemeDescriptor}">
							<TextBlock
								HorizontalAlignment="Center"
								VerticalAlignment="Center"
								FontSize="11"
								FontWeight="SemiBold">
								<TextBlock.Style>
									<Style TargetType="{x:Type TextBlock}">
										<Setter Property="Text" Value="Yes" />
										<Setter Property="Foreground" Value="#166534" />
										<Style.Triggers>
											<DataTrigger Binding="{Binding IsMappedInXmlnsDefinition}" Value="False">
												<Setter Property="Text" Value="MISSING" />
												<Setter Property="Foreground" Value="#B45309" />
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</TextBlock.Style>
							</TextBlock>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
				<DataGridTextColumn
					Width="95"
					Binding="{Binding IsInstantiated}"
					Header="Instantiated" />
				<DataGridTextColumn
					Width="105"
					Binding="{Binding LastColdConstructorMs, StringFormat={}{0:F3}, TargetNullValue=-}"
					FontFamily="Consolas"
					Header="Cold .ctor (ms)" />
				<DataGridTextColumn
					Width="105"
					Binding="{Binding LastColdAllocatedKb, StringFormat={}{0:F1}, TargetNullValue=-}"
					FontFamily="Consolas"
					Header="Cold Alloc (KB)" />
				<DataGridTextColumn
					Width="115"
					Binding="{Binding LastApplyMs, StringFormat={}{0:F2}, TargetNullValue=-}"
					FontFamily="Consolas"
					Header="Apply (ms)" />
				<DataGridTextColumn
					Width="85"
					Binding="{Binding DirectEntryCount, TargetNullValue=-}"
					FontFamily="Consolas"
					Header="Root Keys" />
				<DataGridTextColumn
					Width="90"
					Binding="{Binding MergedDictionaryCount, TargetNullValue=-}"
					FontFamily="Consolas"
					Header="Merged Dicts" />
				<DataGridTextColumn
					Width="290"
					Binding="{Binding InheritanceChain}"
					FontFamily="Consolas"
					Header="Inheritance Chain" />
				<DataGridTextColumn
					Width="280"
					Binding="{Binding ResourceUriText}"
					FontFamily="Consolas"
					Header="GetResourceUri()" />
				<DataGridTextColumn
					Width="190"
					Binding="{Binding AssemblyName}"
					FontFamily="Consolas"
					Header="Assembly" />
			</DataGrid.Columns>
		</DataGrid>
	</DockPanel>
</UserControl>
