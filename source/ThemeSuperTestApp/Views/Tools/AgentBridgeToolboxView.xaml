<UserControl
	x:Class="ThemeSuperTestApp.Views.Tools.AgentBridgeToolboxView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:cal="http://caliburnmicro.com"
	Background="#FFFFFF"
	Foreground="#111827">

	<DockPanel Margin="6">
		<StackPanel DockPanel.Dock="Top">
			<!-- Status Pill + Listener Toggle -->
			<WrapPanel Margin="0,0,0,5" Orientation="Horizontal">
				<Border
					Margin="0,0,8,3"
					Padding="7,2"
					BorderThickness="1"
					CornerRadius="3">
					<Border.Style>
						<Style TargetType="{x:Type Border}">
							<Setter Property="Background" Value="#DCFCE7" />
							<Setter Property="BorderBrush" Value="#86EFAC" />
							<Style.Triggers>
								<DataTrigger Binding="{Binding IsListening}" Value="False">
									<Setter Property="Background" Value="#FEF3C7" />
									<Setter Property="BorderBrush" Value="#FCD34D" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</Border.Style>
					<CheckBox
						Content="Auto-Listen on AgentBridge/inbox/"
						FontSize="11"
						FontWeight="SemiBold"
						IsChecked="{Binding IsListening, Mode=TwoWay}" />
				</Border>

				<Button
					Margin="0,0,5,3"
					Padding="6,2"
					cal:Message.Attach="OpenBridgeFolder"
					Content="Open Folder"
					FontSize="11" />
				<Button
					Margin="0,0,5,3"
					Padding="6,2"
					cal:Message.Attach="CleanOldCaptures"
					Content="Clean Captures"
					FontSize="11" />
				<Button
					Margin="0,0,0,3"
					Padding="6,2"
					cal:Message.Attach="ClearLog"
					Content="Clear Log"
					FontSize="11" />
			</WrapPanel>

			<TextBox
				Margin="0,0,0,6"
				Padding="4,2"
				Background="#F8FAFC"
				BorderBrush="#CBD5E1"
				FontFamily="Consolas"
				FontSize="10.5"
				IsReadOnly="True"
				Text="{Binding BridgeDirectoryPath, Mode=OneWay}"
				ToolTip="Workspace AgentBridge folder path" />

			<TextBlock
				Margin="0,0,0,3"
				FontSize="11"
				FontWeight="SemiBold"
				Foreground="#374151"
				Text="Optional Note for Antigravity (embedded in latest-context.md on F12):" />
			<DockPanel Margin="0,0,0,6">
				<Button
					Margin="5,0,0,0"
					Padding="8,3"
					Background="#4F46E5"
					BorderBrush="#4338CA"
					cal:Message.Attach="SendSnapshotNow"
					Content="Send Snapshot (F12)"
					DockPanel.Dock="Right"
					FontSize="11"
					FontWeight="SemiBold"
					Foreground="#FFFFFF" />
				<TextBox
					VerticalContentAlignment="Center"
					FontSize="11.5"
					Text="{Binding UserSnapshotNote, UpdateSourceTrigger=PropertyChanged}"
					ToolTip="Type a note (e.g., 'Look at the inactive tab border here') and click Send Snapshot" />
			</DockPanel>

			<TextBlock
				Margin="0,0,0,5"
				FontFamily="Consolas"
				FontSize="10.5"
				Foreground="#374151"
				Text="{Binding ToolboxStatusText}"
				TextTrimming="CharacterEllipsis" />
		</StackPanel>

		<!-- Command & Snapshot Activity Log -->
		<DataGrid
			AlternatingRowBackground="#F9FAFB"
			AutoGenerateColumns="False"
			Background="#FFFFFF"
			BorderBrush="#D1D5DB"
			CanUserAddRows="False"
			CanUserDeleteRows="False"
			EnableRowVirtualization="True"
			Foreground="#111827"
			GridLinesVisibility="Horizontal"
			HeadersVisibility="Column"
			HorizontalGridLinesBrush="#E5E7EB"
			IsReadOnly="True"
			ItemsSource="{Binding LogEntries}"
			RowBackground="#FFFFFF">
			<DataGrid.Columns>
				<DataGridTextColumn
					Width="82"
					Binding="{Binding TimestampText}"
					FontFamily="Consolas"
					Header="Time" />
				<DataGridTextColumn
					Width="112"
					Binding="{Binding Direction}"
					FontSize="10.5"
					FontWeight="SemiBold"
					Header="Direction" />
				<DataGridTextColumn
					Width="145"
					Binding="{Binding ActionSummary}"
					FontFamily="Consolas"
					Header="Action" />
				<DataGridTextColumn
					Width="55"
					Binding="{Binding Status}"
					FontWeight="SemiBold"
					Header="Status" />
				<DataGridTextColumn
					Width="65"
					Binding="{Binding DurationMs, StringFormat={}{0:F1}}"
					FontFamily="Consolas"
					Header="ms" />
				<DataGridTextColumn
					Width="220"
					Binding="{Binding Message}"
					Header="Message" />
				<DataGridTextColumn
					Width="240"
					Binding="{Binding PrimaryArtifactPath}"
					FontFamily="Consolas"
					Header="Artifact Path" />
			</DataGrid.Columns>
		</DataGrid>
	</DockPanel>
</UserControl>
