<UserControl
	x:Class="ThemeSuperTestApp.Views.Tools.RuntimeThemeLoaderView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:cal="http://caliburnmicro.com"
	Background="#FFFFFF"
	Foreground="#111827">

	<DockPanel Margin="6">
		<!-- Options & External File Section -->
		<StackPanel DockPanel.Dock="Top">
			<TextBlock
				Margin="0,0,0,3"
				FontSize="11"
				FontWeight="SemiBold"
				Foreground="#374151"
				Text="Control Template Set:" />
			<ComboBox
				Margin="0,0,0,6"
				DisplayMemberPath="DisplayName"
				ItemsSource="{Binding TemplateSets}"
				SelectedItem="{Binding SelectedTemplateSet, Mode=TwoWay}" />

			<TextBlock
				Margin="0,0,0,3"
				FontSize="11"
				FontWeight="SemiBold"
				Foreground="#374151"
				Text="Base Palette (for VS2026 .json overrides):" />
			<ComboBox
				Margin="0,0,0,8"
				DisplayMemberPath="DisplayName"
				ItemsSource="{Binding BasePalettes}"
				SelectedItem="{Binding SelectedBasePalette, Mode=TwoWay}" />

			<TextBlock
				Margin="0,0,0,3"
				FontSize="11"
				FontWeight="SemiBold"
				Foreground="#374151"
				Text="External .vstheme / .vstheme.gz / .json File:" />
			<DockPanel Margin="0,0,0,5">
				<Button
					Margin="4,0,0,0"
					Padding="7,2"
					cal:Message.Attach="BrowseThemeFile"
					Content="Browse..."
					DockPanel.Dock="Right"
					FontSize="11" />
				<TextBox
					VerticalContentAlignment="Center"
					FontFamily="Consolas"
					FontSize="11"
					Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}" />
			</DockPanel>
			<Button
				Margin="0,0,0,8"
				Padding="8,3"
				HorizontalAlignment="Left"
				cal:Message.Attach="LoadAndApplyFile"
				Content="Load &amp; Apply External Theme File"
				FontSize="11"
				FontWeight="SemiBold" />

			<Separator Margin="0,0,0,6" />

			<TextBlock
				Margin="0,0,0,4"
				FontSize="11"
				FontWeight="SemiBold"
				Foreground="#374151"
				Text="Inline VS2026 JSON Override Sandbox:" />
			<WrapPanel Margin="0,0,0,5" Orientation="Horizontal">
				<Button
					Margin="0,0,5,3"
					Padding="7,2"
					cal:Message.Attach="ApplyInlineJsonOverride"
					Content="Apply Live JSON"
					FontSize="11"
					FontWeight="SemiBold" />
				<Button
					Margin="0,0,5,3"
					Padding="6,2"
					cal:Message.Attach="ResetSampleJson"
					Content="Reset Sample"
					FontSize="11" />
				<Button
					Margin="0,0,0,3"
					Padding="6,2"
					cal:Message.Attach="TestMalformedJsonError"
					Content="Test Syntax Error"
					FontSize="11"
					ToolTip="Injects invalid JSON to verify VsJsonThemeParser FormatException (Line, Column) error reporting" />
			</WrapPanel>
		</StackPanel>

		<!-- Status / Parser Diagnostic Banner -->
		<Border
			Margin="0,5,0,0"
			Padding="6,4"
			BorderThickness="1"
			CornerRadius="3"
			DockPanel.Dock="Bottom">
			<Border.Style>
				<Style TargetType="{x:Type Border}">
					<Setter Property="Background" Value="#F0FDF4" />
					<Setter Property="BorderBrush" Value="#86EFAC" />
					<Style.Triggers>
						<DataTrigger Binding="{Binding HasParserError}" Value="True">
							<Setter Property="Background" Value="#FEF2F2" />
							<Setter Property="BorderBrush" Value="#FCA5A5" />
						</DataTrigger>
					</Style.Triggers>
				</Style>
			</Border.Style>
			<TextBlock
				FontFamily="Consolas"
				FontSize="11"
				Text="{Binding LoaderStatusText}"
				TextWrapping="Wrap">
				<TextBlock.Style>
					<Style TargetType="{x:Type TextBlock}">
						<Setter Property="Foreground" Value="#166534" />
						<Style.Triggers>
							<DataTrigger Binding="{Binding HasParserError}" Value="True">
								<Setter Property="Foreground" Value="#B91C1C" />
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</TextBlock.Style>
			</TextBlock>
		</Border>

		<!-- Editable JSON Text Area -->
		<TextBox
			AcceptsReturn="True"
			AcceptsTab="True"
			Background="#F8FAFC"
			BorderBrush="#CBD5E1"
			FontFamily="Consolas"
			FontSize="11.5"
			Foreground="#0F172A"
			HorizontalScrollBarVisibility="Auto"
			Text="{Binding InlineJsonText, UpdateSourceTrigger=PropertyChanged}"
			VerticalScrollBarVisibility="Auto" />
	</DockPanel>
</UserControl>
