<Window
	x:Class="ThemeSuperTestApp.Views.ShellView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:ad="https://github.com/NTLDR2/AvalonDock"
	xmlns:cal="http://caliburnmicro.com"
	xmlns:docking="clr-namespace:ThemeSuperTestApp.Docking"
	xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
	xmlns:models="clr-namespace:ThemeSuperTestApp.Models"
	Width="1520"
	Height="920"
	Background="{Binding ShellRow1BackgroundBrush}"
	UseLayoutRounding="True"
	WindowStartupLocation="CenterScreen">

	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="/ThemeSuperTestApp;component/Docking/DockingResources.xaml" />
			</ResourceDictionary.MergedDictionaries>

			<!-- Color-coded Base-Class Badge Border Style -->
			<Style x:Key="BaseClassBadgeBorderStyle" TargetType="{x:Type Border}">
				<Setter Property="Padding" Value="6,1" />
				<Setter Property="CornerRadius" Value="3" />
				<Setter Property="BorderThickness" Value="1" />
				<Setter Property="Background" Value="#CCFBF1" />
				<Setter Property="BorderBrush" Value="#5EEAD4" />
				<Style.Triggers>
					<DataTrigger Binding="{Binding BaseClassKind}" Value="{x:Static models:ThemeBaseClassKind.DictionaryTheme}">
						<Setter Property="Background" Value="#FEF3C7" />
						<Setter Property="BorderBrush" Value="#FCD34D" />
					</DataTrigger>
					<DataTrigger Binding="{Binding BaseClassKind}" Value="{x:Static models:ThemeBaseClassKind.VsTheme}">
						<Setter Property="Background" Value="#EDE9FE" />
						<Setter Property="BorderBrush" Value="#C4B5FD" />
					</DataTrigger>
				</Style.Triggers>
			</Style>

			<!-- Color-coded Base-Class Badge Text Style -->
			<Style x:Key="BaseClassBadgeTextStyle" TargetType="{x:Type TextBlock}">
				<Setter Property="FontSize" Value="11" />
				<Setter Property="FontWeight" Value="SemiBold" />
				<Setter Property="Foreground" Value="#0F766E" />
				<Style.Triggers>
					<DataTrigger Binding="{Binding BaseClassKind}" Value="{x:Static models:ThemeBaseClassKind.DictionaryTheme}">
						<Setter Property="Foreground" Value="#92400E" />
					</DataTrigger>
					<DataTrigger Binding="{Binding BaseClassKind}" Value="{x:Static models:ThemeBaseClassKind.VsTheme}">
						<Setter Property="Foreground" Value="#5B21B6" />
					</DataTrigger>
				</Style.Triggers>
			</Style>

			<!-- Polarity Indicator Dot Style -->
			<Style x:Key="PolarityDotStyle" TargetType="{x:Type Border}">
				<Setter Property="Width" Value="10" />
				<Setter Property="Height" Value="10" />
				<Setter Property="CornerRadius" Value="5" />
				<Setter Property="BorderThickness" Value="1" />
				<Setter Property="BorderBrush" Value="#6B7280" />
				<Setter Property="Background" Value="#9CA3AF" />
				<Style.Triggers>
					<DataTrigger Binding="{Binding Polarity}" Value="{x:Static models:ThemePolarity.Dark}">
						<Setter Property="Background" Value="#1E1E22" />
						<Setter Property="BorderBrush" Value="#9CA3AF" />
					</DataTrigger>
					<DataTrigger Binding="{Binding Polarity}" Value="{x:Static models:ThemePolarity.Light}">
						<Setter Property="Background" Value="#F9FAFB" />
						<Setter Property="BorderBrush" Value="#6B7280" />
					</DataTrigger>
					<DataTrigger Binding="{Binding Polarity}" Value="{x:Static models:ThemePolarity.Blue}">
						<Setter Property="Background" Value="#2563EB" />
						<Setter Property="BorderBrush" Value="#1D4ED8" />
					</DataTrigger>
				</Style.Triggers>
			</Style>
		</ResourceDictionary>
	</Window.Resources>

	<i:Interaction.Behaviors>
		<docking:ToolboxShortcutBehavior Toolboxes="{Binding Tools}" />
	</i:Interaction.Behaviors>

	<DockPanel>
		<!--
			Host KeyTrigger ActionMessages on a zero-size leaf FrameworkElement, NEVER directly on Window or DockPanel,
			so ActionMessage.ApplyAvailabilityEffect never sets Window.IsEnabled = false.
		-->
		<FrameworkElement
			Width="0"
			Height="0"
			DockPanel.Dock="Top"
			Focusable="False"
			IsHitTestVisible="False">
			<i:Interaction.Triggers>
				<i:KeyTrigger Key="F8">
					<cal:ActionMessage MethodName="NextTheme" />
				</i:KeyTrigger>
				<i:KeyTrigger Key="F8" Modifiers="Shift">
					<cal:ActionMessage MethodName="PreviousTheme" />
				</i:KeyTrigger>
				<i:KeyTrigger Key="F12">
					<cal:ActionMessage MethodName="SendSnapshotToAntigravity" />
				</i:KeyTrigger>
			</i:Interaction.Triggers>
		</FrameworkElement>

		<!-- ==================== ROW 1: MENU + THEME DROPDOWN + BASE-CLASS ARCHITECTURE STRIP ==================== -->
		<Border
			Padding="8,5"
			Background="{Binding ShellRow1BackgroundBrush}"
			BorderBrush="{Binding ShellBorderBrush}"
			BorderThickness="0,0,0,1"
			DockPanel.Dock="Top">
			<WrapPanel VerticalAlignment="Center" Orientation="Horizontal">
				<Menu
					Margin="0,0,10,0"
					VerticalAlignment="Center"
					Background="Transparent"
					Foreground="{Binding ShellForegroundBrush}">
					<MenuItem Header="_File">
						<MenuItem
							cal:Message.Attach="OpenThemeSwatchSheet"
							Header="Open Theme _Swatch Sheet" />
						<MenuItem
							cal:Message.Attach="OpenControlGallery"
							Header="Open _Control &amp; SystemColors Matrix" />
						<Separator />
						<MenuItem
							cal:Message.Attach="ExportDiagnosticReport"
							Header="_Export Full Diagnostic Report (.md)..." />
						<MenuItem
							cal:Message.Attach="CopyFullDiagnosticReport"
							Header="Copy Full _Diagnostic Report to Clipboard" />
						<Separator />
						<MenuItem
							cal:Message.Attach="Exit"
							Header="E_xit"
							InputGestureText="Alt+F4" />
					</MenuItem>
					<MenuItem Header="_View" ItemsSource="{Binding Tools}">
						<MenuItem.ItemContainerStyle>
							<Style TargetType="{x:Type MenuItem}">
								<Setter Property="Header" Value="{Binding Title}" />
								<Setter Property="IsCheckable" Value="True" />
								<Setter Property="IsChecked" Value="{Binding IsOpen, Mode=TwoWay}" />
								<Setter Property="InputGestureText" Value="{Binding Shortcut}" />
								<Setter Property="ToolTip" Value="{Binding ToolTipText}" />
							</Style>
						</MenuItem.ItemContainerStyle>
					</MenuItem>
					<MenuItem Header="_Theme">
						<MenuItem
							cal:Message.Attach="NextTheme"
							Header="_Next Theme"
							InputGestureText="F8" />
						<MenuItem
							cal:Message.Attach="PreviousTheme"
							Header="_Previous Theme"
							InputGestureText="Shift+F8" />
						<Separator />
						<MenuItem
							cal:Message.Attach="ForceColdReloadCurrentTheme"
							Header="_Force Cold Re-Instantiate Active Theme" />
						<MenuItem
							cal:Message.Attach="SyncThemeToOsNow"
							Header="_Sync Theme to Windows OS Mode Now" />
					</MenuItem>
					<MenuItem Header="_Layout">
						<MenuItem cal:Message.Attach="SaveLayout" Header="_Save Layout" />
						<MenuItem cal:Message.Attach="LoadLayout" Header="_Load Layout" />
						<MenuItem cal:Message.Attach="ResetLayout" Header="_Reset Layout" />
					</MenuItem>
					<MenuItem Header="_Diagnostics">
						<MenuItem
							cal:Message.Attach="SpawnOverflowTabs"
							Header="Spawn _10 Overflow Tabs (Test MenuItemEx &amp; Ctrl+Tab)" />
						<MenuItem
							cal:Message.Attach="CloseSpecimenTabs"
							Header="_Close Spawned Overflow Tabs" />
						<Separator />
						<MenuItem
							cal:Message.Attach="SpawnFloatingToolAndDocument"
							Header="Spawn _Floating Document &amp; Toolbox" />
						<MenuItem
							cal:Message.Attach="SpawnDetachedOsWindow"
							Header="Spawn _Detached OS Window ('Window' Mode)" />
						<MenuItem
							cal:Message.Attach="DockAllWindows"
							Header="Re-_Dock All Floating &amp; Detached Windows" />
						<Separator />
						<MenuItem
							cal:Message.Attach="SendSnapshotToAntigravity"
							Header="_Send Multimodal Snapshot to Antigravity"
							InputGestureText="F12" />
						<MenuItem
							cal:Message.Attach="ExportDiagnosticReport"
							Header="_Export Full Markdown Report (.md)..." />
					</MenuItem>
				</Menu>

				<TextBlock
					Margin="0,0,6,0"
					VerticalAlignment="Center"
					FontWeight="SemiBold"
					Foreground="{Binding ShellForegroundBrush}"
					Text="Theme:" />

				<ComboBox
					x:Name="Themes"
					MinWidth="350"
					Margin="0,0,8,0"
					VerticalAlignment="Center"
					SelectedItem="{Binding SelectedTheme, Mode=TwoWay}">
					<ComboBox.ItemTemplate>
						<DataTemplate DataType="{x:Type models:ThemeDescriptor}">
							<StackPanel VerticalAlignment="Center" Orientation="Horizontal">
								<Border
									Margin="0,0,6,0"
									VerticalAlignment="Center"
									Style="{StaticResource PolarityDotStyle}" />
								<TextBlock
									MinWidth="112"
									VerticalAlignment="Center"
									FontWeight="SemiBold"
									Text="{Binding DisplayName}" />
								<Border
									Margin="6,0,6,0"
									VerticalAlignment="Center"
									Style="{StaticResource BaseClassBadgeBorderStyle}">
									<TextBlock
										Style="{StaticResource BaseClassBadgeTextStyle}"
										Text="{Binding BaseClassBadgeText}" />
								</Border>
								<TextBlock
									VerticalAlignment="Center"
									FontFamily="Consolas"
									FontSize="11"
									Opacity="0.72"
									Text="{Binding ClrNamespace}" />
							</StackPanel>
						</DataTemplate>
					</ComboBox.ItemTemplate>
				</ComboBox>

				<!-- Selected Theme Explicit Base-Class & Inheritance Callout -->
				<StackPanel
					DataContext="{Binding SelectedTheme}"
					Orientation="Horizontal"
					VerticalAlignment="Center">
					<Border
						Margin="0,0,8,0"
						VerticalAlignment="Center"
						Style="{StaticResource BaseClassBadgeBorderStyle}"
						ToolTip="Active theme's base-class implementation pattern">
						<TextBlock Style="{StaticResource BaseClassBadgeTextStyle}">
							<Run Text="Base: " />
							<Run Text="{Binding BaseClassBadgeText, Mode=OneWay, FallbackValue=-}" />
						</TextBlock>
					</Border>

					<Border
						Margin="0,0,8,0"
						Padding="6,2"
						VerticalAlignment="Center"
						Background="#F9FAFB"
						BorderBrush="#D1D5DB"
						BorderThickness="1"
						CornerRadius="3"
						ToolTip="{Binding ResourceUriText}">
						<TextBlock
							FontFamily="Consolas"
							FontSize="11"
							Foreground="#111827"
							Text="{Binding InheritanceChain, FallbackValue='-'}" />
					</Border>

					<!-- XmlnsDefinition Status Pill -->
					<Border
						Margin="0,0,8,0"
						Padding="6,1"
						VerticalAlignment="Center"
						BorderThickness="1"
						CornerRadius="3"
						ToolTip="Whether the theme's CLR namespace is registered in [assembly: XmlnsDefinition] for https://github.com/NTLDR2/AvalonDock">
						<Border.Style>
							<Style TargetType="{x:Type Border}">
								<Setter Property="Background" Value="#DCFCE7" />
								<Setter Property="BorderBrush" Value="#86EFAC" />
								<Style.Triggers>
									<DataTrigger Binding="{Binding IsMappedInXmlnsDefinition}" Value="False">
										<Setter Property="Background" Value="#FFEDD5" />
										<Setter Property="BorderBrush" Value="#FDBA74" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</Border.Style>
						<TextBlock
							FontSize="11"
							FontWeight="SemiBold"
							Text="{Binding XmlnsStatusText, FallbackValue=''}">
							<TextBlock.Style>
								<Style TargetType="{x:Type TextBlock}">
									<Setter Property="Foreground" Value="#166534" />
									<Style.Triggers>
										<DataTrigger Binding="{Binding IsMappedInXmlnsDefinition}" Value="False">
											<Setter Property="Foreground" Value="#9A3412" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</TextBlock.Style>
						</TextBlock>
					</Border>
				</StackPanel>

				<!-- Timing Pill -->
				<Border
					Margin="0,0,10,0"
					Padding="6,2"
					VerticalAlignment="Center"
					Background="#EEF2FF"
					BorderBrush="#C7D2FE"
					BorderThickness="1"
					CornerRadius="3"
					ToolTip="Measured cold constructor time and DockingManager.Theme apply time">
					<TextBlock
						FontFamily="Consolas"
						FontSize="11"
						Foreground="#312E81"
						Text="{Binding SelectedThemeTimingText}" />
				</Border>

				<CheckBox
					Margin="0,0,8,0"
					VerticalAlignment="Center"
					Content="Custom Icon Tab Header"
					Foreground="{Binding ShellForegroundBrush}"
					IsChecked="{Binding UseCustomDocumentHeaderTemplate, Mode=TwoWay}"
					ToolTip="Uncheck to set DockingManager.DocumentHeaderTemplate = null and inspect each theme's native tab header template" />

				<!-- Live Antigravity Bridge Status Pill -->
				<Border
					Padding="6,2"
					VerticalAlignment="Center"
					BorderThickness="1"
					CornerRadius="3"
					ToolTip="Live XML mailbox listener on source/ThemeSuperTestApp/AgentBridge/inbox/ (Ctrl+Alt+A to open Tool 6)">
					<Border.Style>
						<Style TargetType="{x:Type Border}">
							<Setter Property="Background" Value="#DCFCE7" />
							<Setter Property="BorderBrush" Value="#86EFAC" />
							<Style.Triggers>
								<DataTrigger Binding="{Binding AgentBridge.IsListening}" Value="False">
									<Setter Property="Background" Value="#FEF3C7" />
									<Setter Property="BorderBrush" Value="#FCD34D" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</Border.Style>
					<TextBlock
						FontFamily="Consolas"
						FontSize="11"
						FontWeight="SemiBold"
						Foreground="#14532D"
						Text="{Binding AgentBridge.BridgeStatusBadgeText}" />
				</Border>
			</WrapPanel>
		</Border>

		<!-- ==================== ROW 2: WINDOWS OS DARK/LIGHT DETECTOR + CHROME CONTROLS ==================== -->
		<Border
			Padding="8,4"
			Background="{Binding ShellRow2BackgroundBrush}"
			BorderBrush="{Binding ShellBorderBrush}"
			BorderThickness="0,0,0,1"
			DockPanel.Dock="Top">
			<WrapPanel VerticalAlignment="Center" Orientation="Horizontal">
				<Border
					Margin="0,0,6,0"
					Padding="6,1"
					VerticalAlignment="Center"
					Background="#E0E7FF"
					BorderBrush="#A5B4FC"
					BorderThickness="1"
					CornerRadius="3">
					<TextBlock
						FontSize="11"
						FontWeight="SemiBold"
						Foreground="#1E3A8A"
						Text="{Binding OsSnapshot.OsVersionCaption}" />
				</Border>

				<!-- OS Apps Mode Pill -->
				<Border
					Margin="0,0,6,0"
					Padding="6,1"
					VerticalAlignment="Center"
					BorderThickness="1"
					CornerRadius="3"
					ToolTip="Registry: HKCU\Software\Microsoft\Windows\CurrentVersion\Themes\Personalize\AppsUseLightTheme">
					<Border.Style>
						<Style TargetType="{x:Type Border}">
							<Setter Property="Background" Value="#F9FAFB" />
							<Setter Property="BorderBrush" Value="#D1D5DB" />
							<Style.Triggers>
								<DataTrigger Binding="{Binding OsSnapshot.AppsThemeMode}" Value="{x:Static models:OsLightDarkState.ExplicitDark}">
									<Setter Property="Background" Value="#1F2937" />
									<Setter Property="BorderBrush" Value="#4B5563" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</Border.Style>
					<TextBlock FontSize="11" FontWeight="SemiBold">
						<TextBlock.Style>
							<Style TargetType="{x:Type TextBlock}">
								<Setter Property="Foreground" Value="#111827" />
								<Style.Triggers>
									<DataTrigger Binding="{Binding OsSnapshot.AppsThemeMode}" Value="{x:Static models:OsLightDarkState.ExplicitDark}">
										<Setter Property="Foreground" Value="#F9FAFB" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</TextBlock.Style>
						<Run Text="OS Apps: " />
						<Run Text="{Binding OsSnapshot.AppsThemeModeText, Mode=OneWay}" />
					</TextBlock>
				</Border>

				<!-- OS System Mode Pill -->
				<Border
					Margin="0,0,6,0"
					Padding="6,1"
					VerticalAlignment="Center"
					Background="#F9FAFB"
					BorderBrush="#D1D5DB"
					BorderThickness="1"
					CornerRadius="3"
					ToolTip="Registry: HKCU\Software\Microsoft\Windows\CurrentVersion\Themes\Personalize\SystemUsesLightTheme">
					<TextBlock
						FontSize="11"
						Foreground="#1F2937">
						<Run Text="OS System: " />
						<Run FontWeight="SemiBold" Text="{Binding OsSnapshot.SystemThemeModeText, Mode=OneWay}" />
					</TextBlock>
				</Border>

				<!-- High Contrast Pill -->
				<Border
					Margin="0,0,6,0"
					Padding="6,1"
					VerticalAlignment="Center"
					BorderThickness="1"
					CornerRadius="3"
					ToolTip="SystemParameters.HighContrast">
					<Border.Style>
						<Style TargetType="{x:Type Border}">
							<Setter Property="Background" Value="#F9FAFB" />
							<Setter Property="BorderBrush" Value="#D1D5DB" />
							<Style.Triggers>
								<DataTrigger Binding="{Binding OsSnapshot.IsHighContrastEnabled}" Value="True">
									<Setter Property="Background" Value="#FEE2E2" />
									<Setter Property="BorderBrush" Value="#FCA5A5" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</Border.Style>
					<TextBlock FontSize="11" Foreground="#111827">
						<Run Text="High Contrast: " />
						<Run FontWeight="SemiBold" Text="{Binding OsSnapshot.HighContrastDisplayText, Mode=OneWay}" />
					</TextBlock>
				</Border>

				<!-- OS Accent Swatch -->
				<Border
					Margin="0,0,8,0"
					Padding="5,1"
					VerticalAlignment="Center"
					Background="#F9FAFB"
					BorderBrush="#D1D5DB"
					BorderThickness="1"
					CornerRadius="3"
					ToolTip="Windows DWM AccentColor">
					<StackPanel Orientation="Horizontal">
						<Border
							Width="11"
							Height="11"
							Margin="0,0,5,0"
							VerticalAlignment="Center"
							Background="{Binding OsSnapshot.OsAccentBrush}"
							BorderBrush="#4B5563"
							BorderThickness="1"
							CornerRadius="2" />
						<TextBlock
							VerticalAlignment="Center"
							FontFamily="Consolas"
							FontSize="11"
							Foreground="#111827"
							Text="{Binding OsSnapshot.OsAccentHex}" />
						<TextBlock
							Margin="5,0,0,0"
							VerticalAlignment="Center"
							FontSize="10.5"
							Foreground="#4B5563">
							<TextBlock.Style>
								<Style TargetType="{x:Type TextBlock}">
									<Setter Property="Text" Value="(TitleBar: Off)" />
									<Style.Triggers>
										<DataTrigger Binding="{Binding OsSnapshot.IsTitleBarAccentColorEnabled}" Value="True">
											<Setter Property="Text" Value="(TitleBar: ON)" />
											<Setter Property="FontWeight" Value="SemiBold" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</TextBlock.Style>
						</TextBlock>
					</StackPanel>
				</Border>

				<!-- Theme vs OS Contrast Notice -->
				<Border
					Margin="0,0,10,0"
					Padding="6,1"
					VerticalAlignment="Center"
					BorderThickness="1"
					CornerRadius="3">
					<Border.Style>
						<Style TargetType="{x:Type Border}">
							<Setter Property="Background" Value="#ECFDF5" />
							<Setter Property="BorderBrush" Value="#6EE7B7" />
							<Style.Triggers>
								<DataTrigger Binding="{Binding HasThemeVsOsMismatch}" Value="True">
									<Setter Property="Background" Value="#FFFBEB" />
									<Setter Property="BorderBrush" Value="#FCD34D" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</Border.Style>
					<TextBlock
						FontSize="11"
						Foreground="#1F2937"
						Text="{Binding ThemeVsOsNoticeText}" />
				</Border>

				<!-- Opt-In Chrome Controls -->
				<TextBlock
					Margin="0,0,4,0"
					VerticalAlignment="Center"
					FontSize="11.5"
					Foreground="{Binding ShellForegroundBrush}"
					Text="DWM Title Bars:" />
				<ComboBox
					MinWidth="195"
					Margin="0,0,10,0"
					VerticalAlignment="Center"
					DisplayMemberPath="DisplayName"
					ItemsSource="{Binding DwmTitleBarModes}"
					SelectedItem="{Binding SelectedDwmTitleBarMode, Mode=TwoWay}"
					ToolTip="Applies DWMWA_USE_IMMERSIVE_DARK_MODE to ShellView and standalone DetachedAnchorableWindows" />

				<CheckBox
					Margin="0,0,10,0"
					VerticalAlignment="Center"
					Content="Style Outer Shell Chrome"
					Foreground="{Binding ShellForegroundBrush}"
					IsChecked="{Binding StyleOuterShellFromTheme, Mode=TwoWay}"
					ToolTip="Toggles outer Menu/Header/StatusBar between raw unthemed net48 chrome and active theme polarity" />

				<CheckBox
					Margin="0,0,8,0"
					VerticalAlignment="Center"
					Content="Auto-Sync to OS"
					Foreground="{Binding ShellForegroundBrush}"
					IsChecked="{Binding AutoSyncThemeToOsMode, Mode=TwoWay}"
					ToolTip="Automatically switches between VS 2022 Dark and VS 2022 Light when Windows OS Apps Mode changes" />

				<Button
					Margin="0,0,6,0"
					Padding="6,1"
					VerticalAlignment="Center"
					cal:Message.Attach="RefreshOsThemeState"
					Content="Refresh OS"
					FontSize="11" />
				<Button
					Margin="0,0,5,0"
					Padding="6,1"
					VerticalAlignment="Center"
					cal:Message.Attach="SpawnOverflowTabs"
					Content="+10 Overflow Tabs"
					FontSize="11"
					ToolTip="Spawns 10 specimen tabs to test MenuItemEx overflow dropdown and Ctrl+Tab NavigatorWindow" />
				<Button
					Margin="0,0,5,0"
					Padding="6,1"
					VerticalAlignment="Center"
					cal:Message.Attach="SpawnFloatingToolAndDocument"
					Content="Float Specimen"
					FontSize="11"
					ToolTip="Floats a document and toolbox into LayoutFloatingWindowControls" />
				<Button
					Margin="0,0,5,0"
					Padding="6,1"
					VerticalAlignment="Center"
					cal:Message.Attach="SpawnDetachedOsWindow"
					Content="Detach OS Window"
					FontSize="11"
					ToolTip="Detaches the specimen toolbox into a standalone top-level DetachedAnchorableWindow" />
				<Button
					Margin="0,0,5,0"
					Padding="6,1"
					VerticalAlignment="Center"
					cal:Message.Attach="DockAllWindows"
					Content="Dock All"
					FontSize="11" />
				<Button
					Margin="0,0,5,0"
					Padding="6,1"
					VerticalAlignment="Center"
					cal:Message.Attach="ExportDiagnosticReport"
					Content="Export .md Report"
					FontSize="11" />
				<Button
					Padding="8,1"
					VerticalAlignment="Center"
					Background="#4F46E5"
					BorderBrush="#4338CA"
					cal:Message.Attach="SendSnapshotToAntigravity"
					Content="Send Snapshot to Antigravity (F12)"
					FontSize="11"
					FontWeight="SemiBold"
					Foreground="#FFFFFF"
					ToolTip="Writes latest-composite.png, latest-main-wpf.png, latest-main-dwm.png, and latest-context.md to source/ThemeSuperTestApp/AgentBridge/latest/" />
			</WrapPanel>
		</Border>

		<!-- ==================== STATUS BAR ==================== -->
		<StatusBar
			Background="{Binding ShellRow2BackgroundBrush}"
			BorderBrush="{Binding ShellBorderBrush}"
			BorderThickness="0,1,0,0"
			DockPanel.Dock="Bottom"
			Foreground="{Binding ShellForegroundBrush}">
			<StatusBarItem>
				<TextBlock x:Name="StatusText" />
			</StatusBarItem>
			<StatusBarItem HorizontalAlignment="Right">
				<TextBlock
					FontFamily="Consolas"
					FontSize="11"
					Text="{Binding SelectedTheme.ResourceUriText, StringFormat=ResourceUri: {0}, FallbackValue=''}" />
			</StatusBarItem>
		</StatusBar>

		<!-- ==================== CLASSIC DOCKINGMANAGER TEST SURFACE ==================== -->
		<ad:DockingManager
			x:Name="DockManager"
			AllowAnchorDoubleClickDock="True"
			DockLayout="{Binding DockLayout}"
			DocumentHeaderTemplate="{StaticResource IconDocumentHeaderTemplate}"
			LayoutItemContainerStyleSelector="{StaticResource PanesStyleSelector}">
			<i:Interaction.Behaviors>
				<docking:DocumentCloseBehavior />
				<docking:ToolboxVisibilityBehavior />
			</i:Interaction.Behaviors>

			<ad:DockingManager.LayoutUpdateStrategy>
				<docking:ZonePlacementStrategy />
			</ad:DockingManager.LayoutUpdateStrategy>

			<ad:LayoutRoot>
				<ad:LayoutPanel Orientation="Horizontal">
					<ad:LayoutAnchorablePaneGroup DockWidth="300" Orientation="Vertical">
						<ad:LayoutAnchorablePane Name="Zone_LeftTop" />
						<ad:LayoutAnchorablePane Name="Zone_LeftBottom" />
					</ad:LayoutAnchorablePaneGroup>
					<ad:LayoutPanel Orientation="Vertical">
						<ad:LayoutDocumentPane />
						<ad:LayoutAnchorablePaneGroup DockHeight="290" Orientation="Horizontal">
							<ad:LayoutAnchorablePane Name="Zone_BottomLeft" />
							<ad:LayoutAnchorablePane Name="Zone_BottomRight" />
						</ad:LayoutAnchorablePaneGroup>
					</ad:LayoutPanel>
					<ad:LayoutAnchorablePaneGroup DockWidth="480" Orientation="Vertical">
						<ad:LayoutAnchorablePane Name="Zone_RightTop" />
						<ad:LayoutAnchorablePane Name="Zone_RightBottom" />
					</ad:LayoutAnchorablePaneGroup>
				</ad:LayoutPanel>
			</ad:LayoutRoot>
		</ad:DockingManager>
	</DockPanel>
</Window>
