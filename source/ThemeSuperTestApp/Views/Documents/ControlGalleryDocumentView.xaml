<UserControl
	x:Class="ThemeSuperTestApp.Views.Documents.ControlGalleryDocumentView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:cal="http://caliburnmicro.com">

	<ScrollViewer VerticalScrollBarVisibility="Auto">
		<Grid Margin="10">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="10" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="10" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

			<!-- ==================== COLUMN A: UNTHEMED NET48 AERO2 CONTROLS ==================== -->
			<Border
				Grid.Column="0"
				Padding="10"
				BorderBrush="#94A3B8"
				BorderThickness="1"
				CornerRadius="4">
				<StackPanel>
					<TextBlock
						Margin="0,0,0,6"
						FontSize="13"
						FontWeight="Bold"
						Text="A. Raw Unthemed WPF Controls (net48 Aero2)" />
					<TextBlock
						Margin="0,0,0,8"
						FontSize="11"
						Opacity="0.85"
						Text="Notice: Foreground on Label/CheckBox/RadioButton/TextBlock inherits from the parent pane unless explicitly set, exposing dark-theme readability bugs!"
						TextWrapping="Wrap" />

					<WrapPanel Margin="0,0,0,6" Orientation="Horizontal">
						<Button
							Margin="0,0,6,4"
							Padding="8,3"
							cal:Message.Attach="ToggleModifiedDot"
							Content="Toggle Dirty Dot" />
						<Button
							Margin="0,0,6,4"
							Padding="8,3"
							Content="Disabled Button"
							IsEnabled="False" />
					</WrapPanel>

					<TextBox
						Margin="0,0,0,6"
						Padding="4,2"
						Text="{Binding SampleText, UpdateSourceTrigger=PropertyChanged}">
						<TextBox.ContextMenu>
							<ContextMenu>
								<MenuItem Command="ApplicationCommands.Cut" />
								<MenuItem Command="ApplicationCommands.Copy" />
								<MenuItem Command="ApplicationCommands.Paste" />
							</ContextMenu>
						</TextBox.ContextMenu>
					</TextBox>

					<ComboBox
						Margin="0,0,0,6"
						ItemsSource="{Binding SampleComboItems}"
						SelectedIndex="0" />

					<CheckBox
						Margin="0,0,0,4"
						Content="Standard CheckBox (Checked)"
						IsChecked="True" />
					<CheckBox
						Margin="0,0,0,6"
						Content="Tri-State CheckBox (Indeterminate)"
						IsChecked="{x:Null}"
						IsThreeState="True" />

					<StackPanel Margin="0,0,0,6" Orientation="Horizontal">
						<RadioButton
							Margin="0,0,10,0"
							Content="Option A"
							IsChecked="True" />
						<RadioButton Content="Option B" />
					</StackPanel>

					<Slider
						Margin="0,0,0,6"
						Maximum="100"
						Minimum="0"
						Value="{Binding SampleSliderValue, Mode=TwoWay}" />
					<ProgressBar
						Height="14"
						Margin="0,0,0,8"
						Maximum="100"
						Value="{Binding SampleSliderValue}" />

					<ListBox
						Height="72"
						Margin="0,0,0,6"
						ItemsSource="{Binding SampleComboItems}"
						SelectedIndex="1" />

					<TreeView Height="85">
						<TreeViewItem Header="Root Node (Right-click or expand)" IsExpanded="True">
							<TreeViewItem Header="Child Leaf 1" />
							<TreeViewItem Header="Child Leaf 2" />
						</TreeViewItem>
					</TreeView>
				</StackPanel>
			</Border>

			<!-- ==================== COLUMN B: LIVE SYSTEMCOLORS.* DYNAMIC RESOURCES ==================== -->
			<Border
				Grid.Column="2"
				Padding="10"
				Background="#F8FAFC"
				BorderBrush="#94A3B8"
				BorderThickness="1"
				CornerRadius="4"
				TextElement.Foreground="#0F172A">
				<StackPanel>
					<TextBlock
						Margin="0,0,0,6"
						FontSize="13"
						FontWeight="Bold"
						Text="B. WPF SystemColors.* (net48 Live Swatches)" />
					<TextBlock
						Margin="0,0,0,8"
						FontSize="11"
						Foreground="#334155"
						Text="On net48, SystemColors stay Light even when Windows OS Dark Mode is Explicit Dark — they only invert when Windows High Contrast is ON."
						TextWrapping="Wrap" />

					<UniformGrid Columns="1">
						<Border Margin="0,0,0,5" Padding="6,4" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" BorderBrush="#64748B" BorderThickness="1">
							<TextBlock FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" Text="WindowBrush / WindowTextBrush" />
						</Border>
						<Border Margin="0,0,0,5" Padding="6,4" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" BorderBrush="#64748B" BorderThickness="1">
							<TextBlock FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" Text="ControlBrush / ControlTextBrush" />
						</Border>
						<Border Margin="0,0,0,5" Padding="6,4" Background="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" BorderBrush="#64748B" BorderThickness="1">
							<TextBlock FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" Text="HighlightBrush / HighlightTextBrush" />
						</Border>
						<Border Margin="0,0,0,5" Padding="6,4" Background="{DynamicResource {x:Static SystemColors.InactiveCaptionBrushKey}}" BorderBrush="#64748B" BorderThickness="1">
							<TextBlock FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource {x:Static SystemColors.InactiveCaptionTextBrushKey}}" Text="InactiveCaptionBrush / TextBrush" />
						</Border>
						<Border Margin="0,0,0,5" Padding="6,4" Background="{DynamicResource {x:Static SystemColors.InfoBrushKey}}" BorderBrush="#64748B" BorderThickness="1">
							<TextBlock FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource {x:Static SystemColors.InfoTextBrushKey}}" Text="InfoBrush (ToolTip) / InfoTextBrush" />
						</Border>
						<Border Padding="6,4" Background="#FFFFFF" BorderBrush="#64748B" BorderThickness="1">
							<TextBlock FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Text="GrayTextBrush (Disabled Text)" />
						</Border>
					</UniformGrid>
				</StackPanel>
			</Border>

			<!-- ==================== COLUMN C: INHERITED SURFACE & DETACH GUIDANCE ==================== -->
			<Border
				Grid.Column="4"
				Padding="10"
				BorderBrush="#94A3B8"
				BorderThickness="1"
				CornerRadius="4">
				<StackPanel>
					<TextBlock
						Margin="0,0,0,6"
						FontSize="13"
						FontWeight="Bold"
						Text="C. Inherited Logical-Tree Surface" />
					<TextBlock
						Margin="0,0,0,10"
						FontSize="11"
						Text="This panel sets NO Background or Foreground: everything you see here is inherited directly from the active AvalonDock DocumentPaneControl / LayoutDocumentFloatingWindowControl / DetachedAnchorableWindow template!"
						TextWrapping="Wrap" />

					<GroupBox Margin="0,0,0,8" Header="Inherited Typography Check">
						<StackPanel Margin="6">
							<TextBlock FontSize="14" FontWeight="SemiBold" Text="Heading 14pt SemiBold (Inherited Foreground)" />
							<TextBlock Margin="0,4,0,0" FontFamily="Consolas" FontSize="11.5" Text="Monospace 11.5pt: 0x007ACC -> SolidColorBrush.IsFrozen" />
						</StackPanel>
					</GroupBox>

					<Expander Header="Tear-Off &amp; Window Mode Checklist" IsExpanded="True">
						<StackPanel Margin="6">
							<TextBlock Margin="0,0,0,4" FontSize="11" Text="1. Drag this tab out to create a LayoutDocumentFloatingWindowControl." TextWrapping="Wrap" />
							<TextBlock Margin="0,0,0,4" FontSize="11" Text="2. Check Tool 3 (Multi-Window Dict Sharing) to compare URI Theme vs. DictionaryTheme." TextWrapping="Wrap" />
							<TextBlock FontSize="11" Text="3. Right-click any toolbox header and choose 'Window' (or click 'Spawn Detached OS Window' in the menu) to test DetachedAnchorableWindow + DWM Dark Title Bars." TextWrapping="Wrap" />
						</StackPanel>
					</Expander>
				</StackPanel>
			</Border>
		</Grid>
	</ScrollViewer>
</UserControl>
