<UserControl
	x:Class="ThemeSuperTestApp.Views.Documents.ThemeOverviewDocumentView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:models="clr-namespace:ThemeSuperTestApp.Models">

	<DockPanel Margin="10">
		<!-- Header Card (intentionally uses crisp neutral card so swatches are judged accurately regardless of pane background) -->
		<Border
			Margin="0,0,0,8"
			Padding="10,7"
			Background="#F8FAFC"
			BorderBrush="#CBD5E1"
			BorderThickness="1"
			CornerRadius="4"
			DockPanel.Dock="Top">
			<StackPanel>
				<TextBlock
					FontSize="14"
					FontWeight="Bold"
					Foreground="#0F172A"
					Text="{Binding ActiveThemeHeadline}" />
				<TextBlock
					Margin="0,3,0,0"
					FontFamily="Consolas"
					FontSize="11"
					Foreground="#334155"
					Text="{Binding ActiveThemeSubheadline}"
					TextWrapping="Wrap" />
			</StackPanel>
		</Border>

		<ScrollViewer VerticalScrollBarVisibility="Auto">
			<ItemsControl ItemsSource="{Binding BrushSwatches}">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<WrapPanel Orientation="Horizontal" />
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
				<ItemsControl.ItemTemplate>
					<DataTemplate DataType="{x:Type models:ResourceEntryRecord}">
						<Border
							Width="220"
							Margin="0,0,8,8"
							Padding="6"
							Background="#FFFFFF"
							BorderBrush="#CBD5E1"
							BorderThickness="1"
							CornerRadius="4"
							ToolTip="{Binding SourceLocation}">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="38" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>

								<Border
									Grid.Column="0"
									Width="32"
									Height="32"
									VerticalAlignment="Center"
									Background="{Binding SwatchBrush}"
									BorderBrush="#475569"
									BorderThickness="1"
									CornerRadius="3" />

								<StackPanel Grid.Column="1" Margin="6,0,0,0">
									<TextBlock
										FontFamily="Consolas"
										FontSize="10.5"
										FontWeight="SemiBold"
										Foreground="#0F172A"
										Text="{Binding KeyDisplay}"
										TextTrimming="CharacterEllipsis"
										ToolTip="{Binding KeyDisplay}" />
									<StackPanel Margin="0,2,0,0" Orientation="Horizontal">
										<TextBlock
											FontFamily="Consolas"
											FontSize="10.5"
											Foreground="#334155"
											Text="{Binding ColorHex, TargetNullValue=-}" />
										<TextBlock
											Margin="6,0,0,0"
											FontSize="10"
											FontWeight="SemiBold"
											Text="{Binding FreezeStatusText}">
											<TextBlock.Style>
												<Style TargetType="{x:Type TextBlock}">
													<Setter Property="Foreground" Value="#15803D" />
													<Style.Triggers>
														<DataTrigger Binding="{Binding FreezeStatus}" Value="{x:Static models:ResourceFreezeStatus.UnfrozenWarning}">
															<Setter Property="Foreground" Value="#DC2626" />
														</DataTrigger>
													</Style.Triggers>
												</Style>
											</TextBlock.Style>
										</TextBlock>
									</StackPanel>
								</StackPanel>
							</Grid>
						</Border>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</ScrollViewer>
	</DockPanel>
</UserControl>
