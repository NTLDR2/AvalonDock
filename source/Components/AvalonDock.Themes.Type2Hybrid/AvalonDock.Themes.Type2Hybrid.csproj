<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
	<PropertyGroup>
		<AssemblyName>AvalonDock.Themes.Type2Hybrid</AssemblyName>
		<RootNamespace>AvalonDock.Themes.Type2Hybrid</RootNamespace>
		<PackageId>Dirkster.AvalonDock.Themes.Type2Hybrid</PackageId>
		<Description>Hybrid DictionaryTheme-based Visual Studio 2013 themes (Dark, Blue, Light) for AvalonDock.</Description>
		<TargetFrameworks>$(ComponentTargetFrameworks)</TargetFrameworks>
		<UseWPF>true</UseWPF>
		<AssemblyOriginatorKeyFile>sn.snk</AssemblyOriginatorKeyFile>
		<SignAssembly>true</SignAssembly>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
	</PropertyGroup>

	<ItemGroup>
		<Resource Include="**\*.png" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Resources\vs2013blue.vstheme.gz" />
		<EmbeddedResource Include="Resources\vs2013dark.vstheme.gz" />
		<EmbeddedResource Include="Resources\vs2013light.vstheme.gz" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\AvalonDock\AvalonDock.csproj" />
		<ProjectReference Include="..\AvalonDock.Themes.Type3New\AvalonDock.Themes.Type3New.csproj" />
	</ItemGroup>
</Project>