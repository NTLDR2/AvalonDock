<Window x:Class="CaliburnDockTestApp.Views.MainWindowView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avalonDock="https://github.com/NTLDR2/AvalonDock"
        xmlns:cal="http://caliburnmicro.com"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:local="clr-namespace:CaliburnDockTestApp"
        xmlns:vm="clr-namespace:CaliburnDockTestApp.ViewModels"
        mc:Ignorable="d"
        Height="450" Width="800">
    <!--
        Window.Title is intentionally omitted here so Caliburn.Micro's WindowManager.CreateWindowAsync
        automatically binds it TwoWay to MainWindowViewModel.DisplayName ("Caliburn AvalonDock Test").
    -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:ActiveDocumentConverter x:Key="ActiveDocumentConverter"/>
        <Style x:Key="Flat">
            <Setter Property="Control.Background" Value="{x:Null}" />
            <Setter Property="Control.BorderBrush" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="Control.IsMouseOver" Value="True">
                    <Setter Property="Control.Background" Value="{x:Null}" />
                    <Setter Property="Control.BorderBrush" Value="{x:Null}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!--
            MenuItem actions use concise cal:Message.Attach shorthand ("Click" is MenuItem's default trigger in
            ConventionManager) so literal string arguments ('Test A'..'Test D') can be passed to OpenDocumentAsync.
            Each Window menu item also binds IsChecked OneWay to MainWindowViewModel.ActiveItem via ActiveDocumentConverter
            (leaving IsCheckable="False" so clicking an already-active item never unchecks it). Because Conductor.ActiveItem
            holds at most 1 active document (even across split panes or floating windows, and null when all tabs close),
            at most 1 checkmark is ever displayed—using the native OS/WPF menu gutter checkmark regardless of menu header name.
        -->
        <Menu Grid.Row="0" Grid.ColumnSpan="2">
            <MenuItem Header="_Window">
                <MenuItem Header="Window A"
                          IsChecked="{Binding ActiveItem, Converter={StaticResource ActiveDocumentConverter}, ConverterParameter=TestA, Mode=OneWay}"
                          cal:Message.Attach="OpenDocumentAsync('Test A')"/>
                <MenuItem Header="Window B"
                          IsChecked="{Binding ActiveItem, Converter={StaticResource ActiveDocumentConverter}, ConverterParameter=TestB, Mode=OneWay}"
                          cal:Message.Attach="OpenDocumentAsync('Test B')"/>
                <MenuItem Header="Window C"
                          IsChecked="{Binding ActiveItem, Converter={StaticResource ActiveDocumentConverter}, ConverterParameter=TestC, Mode=OneWay}"
                          cal:Message.Attach="OpenDocumentAsync('Test C')"/>
                <MenuItem Header="Window D"
                          IsChecked="{Binding ActiveItem, Converter={StaticResource ActiveDocumentConverter}, ConverterParameter=TestD, Mode=OneWay}"
                          cal:Message.Attach="OpenDocumentAsync('Test D')"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_What's This App About..."
                          cal:Message.Attach="ShowAboutAsync"/>
            </MenuItem>
        </Menu>

        <Border Grid.Row="1" Grid.Column="0" Background="LightGray">
            <TextBlock Text="AvalonDock" HorizontalAlignment="Center"/>
        </Border>
        <!--
            Mode B (DocumentsSource + ActiveContent) is used intentionally instead of Mode A (DockLayout) so
            DockManager (left) and TabManager (right) bind symmetrically to MainWindowViewModel.Items and ActiveItem
            with zero IDockable wrapper boilerplate. Unfiltered TwoWay ActiveContent is safe because this sample
            hosts documents only (no AnchorablesSource tool panes; see ExperimentalTestApp for Mode A + tools).
        -->
        <avalonDock:DockingManager x:Name="DockManager"
                                   Grid.Row="2" Grid.Column="0"
                                   ActiveContent="{Binding ActiveItem, Mode=TwoWay}"
                                   DocumentsSource="{Binding Items}">
            <i:Interaction.Behaviors>
                <local:DocumentCloseBehavior/>
            </i:Interaction.Behaviors>
            <!--
                DocumentHeaderTemplate's DataContext is LayoutDocument. Binding TitleText to LayoutDocument.Title
                (populated from Model.DisplayName via LayoutItemContainerStyle below) avoids transient null-hop
                glitches when AvalonDock clears LayoutDocument.Content = null prior to tab visual teardown.
            -->
            <avalonDock:DockingManager.DocumentHeaderTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="DirtyIndicator" Grid.Column="0" Height="6" Width="6" StrokeThickness="1" Stroke="Black" Fill="Red" SnapsToDevicePixels="True"
                                 Visibility="{Binding Content.IsDirty, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}" Margin="1,0,1,0"/>
                        <TextBlock x:Name="TitleText" Grid.Column="1" Margin="1,0,1,0" MaxWidth="200"
                                   Text="{Binding Title}"
                                   ToolTip="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </DataTemplate>
            </avalonDock:DockingManager.DocumentHeaderTemplate>
            <!--
                Host Caliburn.Micro views via an implicit DataTemplate keyed by ViewModel type (leaving
                DockingManager.LayoutItemTemplate unset) so LayoutItem.View resolves with DataContext = ViewModel
                consistently across docked and floating panes on the default ViewAware context.
            -->
            <avalonDock:DockingManager.Resources>
                <DataTemplate DataType="{x:Type vm:ViewModelBase}">
                    <ContentControl cal:View.Model="{Binding}" IsTabStop="False"/>
                </DataTemplate>
            </avalonDock:DockingManager.Resources>
            <!--
                LayoutItem.DataContext is the LayoutItem wrapper itself; LayoutItem.Model points to the ViewModel.
                Map logical identity (Model.Id -> ContentId) separately from presentation (Model.DisplayName -> Title).
            -->
            <avalonDock:DockingManager.LayoutItemContainerStyle>
                <Style TargetType="{x:Type avalonDock:LayoutItem}">
                    <Setter Property="ContentId" Value="{Binding Model.Id, Mode=OneWay}"/>
                    <Setter Property="Title" Value="{Binding Model.DisplayName, Mode=OneWay}"/>
                </Style>
            </avalonDock:DockingManager.LayoutItemContainerStyle>
        </avalonDock:DockingManager>

        <Border Grid.Row="1" Grid.Column="1" Background="LightGray">
            <TextBlock Text="TabControl" HorizontalAlignment="Center"/>
        </Border>
        <TabControl x:Name="TabManager"
                    Grid.Row="2" Grid.Column="1"
                    ItemsSource="{Binding Items}"
                    SelectedItem="{Binding ActiveItem, Mode=TwoWay}">
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="DirtyIndicator"
                                 Grid.Column="0"
                                 Height="6"
                                 Width="6"
                                 Fill="Red"
                                 StrokeThickness="1"
                                 Stroke="Black"
                                 SnapsToDevicePixels="True"
                                 Visibility="{Binding IsDirty, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"
                                 Margin="1,0,1,0"/>
                        <TextBlock x:Name="TitleText"
                                   Grid.Column="1"
                                   Margin="1,0,1,0"
                                   MaxWidth="200"
                                   Text="{Binding DisplayName}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding DisplayName}"/>
                        <!--
                            Inside an ItemTemplate DataTemplate, top-level ViewModelBinder.BindActions does not run;
                            cal:Message.Attach bubbles up the visual tree to MainWindowViewModel.CloseDocumentAsync
                            and passes the tab's TestViewModel via Caliburn.Micro's $dataContext special value.
                        -->
                        <Button Grid.Column="2"
                                Margin="4,0,0,0"
                                FontFamily="Marlett"
                                Content="r"
                                cal:Message.Attach="CloseDocumentAsync($dataContext)">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}" BasedOn="{StaticResource Flat}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}" Value="False">
                                            <Setter Property="Visibility" Value="Hidden"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <ContentControl cal:View.Model="{Binding}" cal:View.Context="TabControl" IsTabStop="False"/>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>

    </Grid>
</Window>