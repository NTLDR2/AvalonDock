<Window x:Class="CaliburnDockTestApp.Views.AboutView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <!--
        Pure Caliburn.Micro conventions (zero manual {Binding} or cal:Message.Attach):
        - Window.Title is bound automatically to AboutViewModel.DisplayName by WindowManager.CreateWindowAsync.
        - TextBlock "AboutTitle" and read-only TextBox "AboutText" bind OneWay (get-only properties).
        - Button is named "Ok" (-> OkAsync) rather than "Close" because AboutView subclasses System.Windows.Window,
          where a generated field named "Close" would hide Window.Close() (CS0108).
    -->
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="AboutTitle"
                   Grid.Row="0"
                   Margin="0,0,0,8"
                   TextWrapping="Wrap"/>

        <TextBox x:Name="AboutText"
                 Grid.Row="1"
                 Margin="0,0,0,12"
                 Padding="8"
                 MaxHeight="380"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"/>

        <Button x:Name="Ok"
                Grid.Row="2"
                Content="OK"
                MinWidth="75"
                Padding="12,3"
                HorizontalAlignment="Right"
                IsDefault="True"
                IsCancel="True"/>
    </Grid>
</Window>