<Project Sdk="Microsoft.NET.Sdk">

	<!--
		ExperimentalTestApp - reference sample for AvalonDock v5 (classic DockingManager, DockLayout + IDockLayoutService)
		hosted by Caliburn.Micro 6.0.15-beta (SimpleContainer). See README.md for a file-by-file guide.
	-->
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFrameworks>net8.0-windows;net48</TargetFrameworks>
		<UseWPF>true</UseWPF>
		<!-- Caliburn.Micro resolves pack URIs from the root namespace: keep RootNamespace == AssemblyName. -->
		<RootNamespace>ExperimentalTestApp</RootNamespace>
		<AssemblyName>ExperimentalTestApp</AssemblyName>
		<Nullable>enable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<!--
			Caliburn.Micro 6.0.15-beta is built from upstream commit 83e93b34, which is part of the NTLDR2 fork history
			(https://github.com/NTLDR2/Caliburn.Micro). The fork adds AI-friendly documentation only - no runtime changes.
			Dependency graph: Caliburn.Micro.Core (netstandard2.0, no dependencies) + Microsoft.Xaml.Behaviors.Wpf (no dependencies).
		-->
		<PackageReference Include="Caliburn.Micro" Version="6.0.15-beta" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Components\AvalonDock\AvalonDock.csproj" />
		<ProjectReference Include="..\Components\AvalonDock.Core\AvalonDock.Core.csproj" />
		<ProjectReference Include="..\Components\AvalonDock.Mvvm\AvalonDock.Mvvm.csproj" />
		<ProjectReference Include="..\Components\AvalonDock.Serializer.Xml\AvalonDock.Serializer.Xml.csproj" />
		<ProjectReference Include="..\Components\AvalonDock.Themes.VS2010\AvalonDock.Themes.VS2010.csproj" />
		<ProjectReference Include="..\Components\AvalonDock.Themes.Arc\AvalonDock.Themes.Arc.csproj" />
		<ProjectReference Include="..\Components\AvalonDock.Themes.Metro\AvalonDock.Themes.Metro.csproj" />
		<ProjectReference Include="..\Components\AvalonDock.Themes.Expression\AvalonDock.Themes.Expression.csproj" />
		<ProjectReference Include="..\Components\AvalonDock.Themes.Aero\AvalonDock.Themes.Aero.csproj" />
	</ItemGroup>

</Project>
