<UserControl
	x:Class="ExperimentalTestApp.Views.Tools.CaliburnLogView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	d:DesignHeight="200"
	d:DesignWidth="600"
	mc:Ignorable="d">
	<DockPanel>
		<StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
			<Button
				x:Name="Clear"
				Margin="4"
				Padding="10,2"
				Content="Clear" />
			<!-- Convention: a CheckBox named IncludeDiagnostics is bound two-way to IsChecked. -->
			<CheckBox
				x:Name="IncludeDiagnostics"
				Margin="8,4"
				VerticalAlignment="Center"
				Content="Show binder/action diagnostics" />
		</StackPanel>
		<!-- Convention: ItemsSource <- Entries (an explicit ItemTemplate keeps Caliburn.Micro's default item template out). -->
		<ListBox
			x:Name="Entries"
			BorderThickness="0"
			FontFamily="Consolas"
			FontSize="12"
			VirtualizingPanel.IsVirtualizing="True">
			<ListBox.ItemTemplate>
				<DataTemplate>
					<TextBlock>
						<Run Text="{Binding Timestamp, StringFormat=HH:mm:ss.fff, Mode=OneWay}" />
						<Run Text="{Binding Level, Mode=OneWay}" />
						<Run FontWeight="SemiBold" Text="{Binding Source, Mode=OneWay}" />
						<Run Text="{Binding Message, Mode=OneWay}" />
					</TextBlock>
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>
	</DockPanel>
</UserControl>
