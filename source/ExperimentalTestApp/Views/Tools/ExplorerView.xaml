<UserControl
	x:Class="ExperimentalTestApp.Views.Tools.ExplorerView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:cal="http://caliburnmicro.com"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	d:DesignHeight="300"
	d:DesignWidth="250"
	mc:Ignorable="d">
	<DockPanel>
		<!-- Convention: the button named OpenSelected calls OpenSelected(); CanOpenSelected drives IsEnabled. -->
		<Button
			x:Name="OpenSelected"
			Margin="4"
			HorizontalAlignment="Left"
			Padding="10,2"
			Content="Open"
			DockPanel.Dock="Bottom" />
		<!--
			Convention: ItemsSource <- Files and SelectedItem <- SelectedFile.
			An explicit ItemTemplate is required: without one Caliburn.Micro applies its default
			"ContentControl cal:View.Model" item template and looks for a view per item.
		-->
		<ListBox
			x:Name="Files"
			BorderThickness="0"
			cal:Message.Attach="[Event MouseDoubleClick] = [Action OpenSelected]">
			<ListBox.ItemTemplate>
				<DataTemplate>
					<TextBlock Text="{Binding Key}" />
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>
	</DockPanel>
</UserControl>
