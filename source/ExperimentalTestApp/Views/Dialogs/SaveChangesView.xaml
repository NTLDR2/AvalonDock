<UserControl
	x:Class="ExperimentalTestApp.Views.Dialogs.SaveChangesView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d">
	<!-- Shown by IWindowManager.ShowDialogAsync, which wraps this UserControl in a modal Window. -->
	<StackPanel Margin="16" MinWidth="320">
		<TextBlock
			x:Name="Message"
			MaxWidth="420"
			Margin="0,0,0,16"
			TextWrapping="Wrap" />
		<StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
			<!-- Convention: buttons named Save / Discard / Cancel call the methods of the same name. -->
			<Button
				x:Name="Save"
				MinWidth="80"
				Margin="0,0,8,0"
				Content="_Save"
				IsDefault="True" />
			<Button
				x:Name="Discard"
				MinWidth="80"
				Margin="0,0,8,0"
				Content="_Don't Save" />
			<Button
				x:Name="Cancel"
				MinWidth="80"
				Content="Cancel"
				IsCancel="True" />
		</StackPanel>
	</StackPanel>
</UserControl>
